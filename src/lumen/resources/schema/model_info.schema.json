{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lumen.local/model_info.schema.json",
  "title": "Model Info",
  "description": "Runtime-facing schema for model assets consumed directly by Lumen.",
  "type": "object",
  "required": [
    "name",
    "version",
    "description",
    "model_type",
    "source",
    "runtimes"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Stable model asset identifier.",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "description": "Semantic version of this asset package.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string",
      "description": "Short human-readable description of the asset package.",
      "minLength": 1,
      "maxLength": 500
    },
    "model_type": {
      "type": "string",
      "description": "High-level task family, for example `clip`, `face`, `ocr`, or `vlm`.",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "description": "Weak source reference for runtime introspection only.",
      "required": [
        "format",
        "repo_id"
      ],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "huggingface",
            "openclip",
            "modelscope",
            "custom",
            "local"
          ]
        },
        "repo_id": {
          "type": "string",
          "description": "Upstream identifier or local logical identifier.",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "runtimes": {
      "type": "object",
      "description": "Runtime inventory available to Lumen. Files are derived from runtime, component, and precision naming conventions.",
      "minProperties": 1,
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "object",
          "required": [
            "available",
            "components",
            "precisions"
          ],
          "properties": {
            "available": {
              "type": "boolean",
              "description": "Whether this runtime has packaged artifacts for the model."
            },
            "components": {
              "type": "array",
              "description": "Logical model components, such as `vision`, `text`, `detection`, or `recognition`.",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "precisions": {
              "type": "array",
              "description": "Packaged artifact precisions, such as `fp32`, `fp16`, or `int8`.",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "task_metadata": {
      "type": "object",
      "description": "Task-specific weak contract area. Its structure is intentionally model-family-specific and may vary across tasks.",
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "description": "Optional descriptive metadata for humans and tooling.",
      "properties": {
        "license": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
